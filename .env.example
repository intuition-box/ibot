# ibot — the Intuition community's utility bot (tickets + resources panel).

# Required: ibot's Discord bot token.
DISCORD_TOKEN=

# Guild (server) ID — required to register the /support and /resources slash commands.
GUILD_ID=

# Discord user IDs allowed to run the slash commands (comma-separated).
# Empty = anyone with the ManageGuild permission passes.
OWNER_IDS=

# Category ID that open ticket channels are created under (optional).
OPEN_TICKETS_CATEGORY_ID=

# Where the support database lives (default: data/db). Gitignored runtime state.
# DB_DIR=data/db

# Verbose logging.
# DEBUG=true
